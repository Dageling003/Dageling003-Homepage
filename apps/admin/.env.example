# Admin 前端功能开关。构建时读取。
# 复制此文件为 .env 并按需修改。

# 审计日志菜单 + Dashboard 活动区显示
# 后端也要相应设置 AUDIT_ENABLED=true 才真正落库
# VITE_AUDIT_ENABLED=true

# 登录页显示「忘记密码」入口 + 允许访问 /forgot-password / /reset-password
# 后端也要相应设置 PASSWORD_RESET_ENABLED=true 才生效
# VITE_PASSWORD_RESET_ENABLED=true

# 前台主页地址（用于「查看站点」按钮）
# VITE_FRONTEND_URL=http://localhost:3000

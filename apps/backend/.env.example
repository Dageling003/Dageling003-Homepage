# ====================================
# homepage Backend — 环境变量配置示例
# 复制此文件为 .env 后按需修改。切勿提交真实 .env 到 Git。
# ====================================

# JWT 密钥。生产环境用随机字符串：`openssl rand -base64 32`
# 启动时最低长度校验 = MIN_JWT_LENGTH（默认 16）
JWT_SECRET=replace-with-a-strong-random-secret

# 应用端口
PORT=8000

# ====================================
# 默认管理员账号初始化（可选）
#   留空 → 首次访问 /admin/setup 引导创建管理员（推荐）
#   设置 → 需 ≥ MIN_PASSWORD_LENGTH（默认 8）位，后端启动时自动 seed admin
# ====================================
DEFAULT_ADMIN_PASSWORD=

# 公网部署强烈推荐：防止上线到 setup 之间的窗口被抢注
# 生成：openssl rand -hex 24
# SETUP_TOKEN=

# ====================================
# 数据库（默认 sqlite，够用又省事）
#   DB_TYPE=sqlite   ← 默认。使用 better-sqlite3，单文件持久化
#   DB_TYPE=sqljs    仅老开发档兜底，生产禁用
#   DB_TYPE=mariadb  高级：多人协作 / 大流量场景
# ====================================
DB_TYPE=sqlite
DB_SQLITE_PATH=data/homepage.sqlite

# 仅 DB_TYPE=mariadb 时生效
# DB_HOST=localhost
# DB_PORT=3306
# DB_USERNAME=homepage
# DB_PASSWORD=homepage_pass
# DB_DATABASE=homepage

# 生产 MariaDB 场景务必设 false + 用 migration；sqlite 场景默认 true（安全）
# DB_SYNCHRONIZE=false

# CORS 允许的前端来源（多个逗号分隔）
# CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ====================================
# Feature toggles（默认全关，个人主页体验优先。想要的功能显式开启）
# ====================================

# 审计日志：默认关。开启后所有配置修改 / 登录 / 改密都会写 audit_logs 表
# AUDIT_ENABLED=true

# 忘记密码 + SMTP：默认关。开启后需要配下面的 SMTP_* 才能发邮件
# PASSWORD_RESET_ENABLED=true

# 全局限流（120 req/min）：默认关。登录接口的 5 req/min 硬限一直生效
# THROTTLE_ENABLED=true
# THROTTLE_LIMIT=120

# 严格安全响应头（严格 CSP + HSTS preload + COEP）：默认关，会阻止 iframe / 跨域资源
# SECURITY_HEADERS_STRICT=true

# ====================================
# 安全阈值（都可以按需调高）
# ====================================
# BCRYPT_ROUNDS=10          # bcrypt 强度：10 ≈ 60ms（默认），12 ≈ 250ms
# MIN_PASSWORD_LENGTH=8     # 密码最少长度
# MIN_JWT_LENGTH=16         # JWT_SECRET 最少长度

# ====================================
# SMTP 邮件（仅 PASSWORD_RESET_ENABLED=true 生效）
# 参考：
#   QQ 邮箱      smtp.qq.com:465    SMTP_SECURE=true
#   163 邮箱     smtp.163.com:465   SMTP_SECURE=true
#   Gmail        smtp.gmail.com:465 SMTP_SECURE=true（需应用专用密码）
#   Outlook      smtp.office365.com:587 SMTP_SECURE=false
# ====================================
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-account@qq.com
# SMTP_PASS=your-smtp-token
# SMTP_FROM="Homepage <noreply@example.com>"
# SMTP_REJECT_UNAUTHORIZED=true
# 找回密码链接的域名（不配则用 CORS_ORIGIN 拼）
# PUBLIC_ADMIN_URL=https://your-domain.com

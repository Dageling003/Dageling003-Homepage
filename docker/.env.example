# ====================================
# homepage — Docker 部署环境变量
# 复制为 .env.docker 后修改（或运行 bash scripts/deploy.sh 自动生成）
# ====================================

# 域名或 IP（必填）
#   域名（myhomepage.example.com）→ 自动申请 HTTPS 证书
#   内网 IP（192.168.1.100）→ 仅 HTTP
DOMAIN=your-domain-or-ip

# JWT 密钥（必填）。默认最低长度 16（MIN_JWT_LENGTH）
# 生成命令：openssl rand -base64 32
JWT_SECRET=replace-with-a-strong-random-secret

# 默认管理员密码（可选）。默认最低长度 8（MIN_PASSWORD_LENGTH）
#   留空 → 首次访问 /admin/setup 引导创建
#   不留空 → 首次启动自动 seed admin
DEFAULT_ADMIN_PASSWORD=

# 初始化令牌（可选，公网部署强烈推荐）
# 生成命令：openssl rand -hex 24
# 首次初始化后可以从 .env.docker 删除
SETUP_TOKEN=

# ====================================
# 数据库（默认 sqlite）
# ====================================
#   DB_TYPE=sqlite   ← 默认，单文件持久化到 app_data 卷。个人主页足够
#   DB_TYPE=mariadb  高级：多流量 / 多副本
DB_TYPE=sqlite
DB_SQLITE_PATH=/app/data/homepage.sqlite

# 仅 DB_TYPE=mariadb 时需要（并同时用 --profile mariadb 启动 mariadb 服务）
# DB_ROOT_PASSWORD=
# DB_USERNAME=homepage
# DB_PASSWORD=
# DB_DATABASE=homepage
# DB_SYNCHRONIZE=false
# DB_MIGRATIONS_RUN=true

# ====================================
# Feature toggles（默认全关，个人主页体验优先）
# ====================================
# AUDIT_ENABLED=true                # 审计日志
# PASSWORD_RESET_ENABLED=true       # 忘记密码 + SMTP
# THROTTLE_ENABLED=true             # 全局限流 120/min
# LOGIN_THROTTLE_LIMIT=10          # 认证接口限流次数（登录/重置/创建管理员，默认 5）
# LOGIN_THROTTLE_TTL=120           # 认证接口限流时间窗口秒（默认 60）
# SECURITY_HEADERS_STRICT=true      # 严格 CSP + HSTS preload + COEP

# 前端功能（VITE_* 是构建时注入，需重新构建镜像）
# VITE_AUDIT_ENABLED=true
# VITE_PASSWORD_RESET_ENABLED=true
# VITE_PWA_ENABLED=true
# VITE_AMBIENT_ENABLED=true         # 前台磨砂玻璃 orbs + grain 背景

# ====================================
# 安全阈值（可调）
# ====================================
# BCRYPT_ROUNDS=10
# MIN_PASSWORD_LENGTH=8
# MIN_JWT_LENGTH=16

# ====================================
# ACME / HTTPS（仅域名部署）
# ====================================
# 国内默认 ZeroSSL；想切 Let's Encrypt：
#   ACME_CA=https://acme-v02.api.letsencrypt.org/directory
ACME_CA=https://acme.zerossl.com/v2/DV90
# ACME_EMAIL：ZeroSSL / Let's Encrypt 账号邮箱
#   留空       → Caddy 自动生成匿名账号（可用但无过期提醒）
#   真实邮箱   → 推荐，可收证书到期 / 吊销通知
#   占位符如 your-email@example.com → 容器启动时会 fail-fast 拒绝启动
ACME_EMAIL=

# ====================================
# 构建镜像源（可选，国内部署推荐）
# ====================================
# docker.1ms.run 只代理 Docker Hub，不代理 gcr.io。
# 详见 docs/deployment.md → 「docker.1ms.run 的边界」章节。
# ✅ BUILDER_IMAGE 可用镜像加速器：
# BUILDER_IMAGE=docker.1ms.run/library/node:22-slim
# ❌ 千万别把 gcr.io 塞进镜像加速器路径，会 404：
#    RUNTIME_IMAGE=docker.1ms.run/gcr.io/distroless/nodejs22-debian12   # ← 报 not found
# ✅ 纯国内节点建议改用 node:22-slim 做 runtime（镜像大一点但一定拉得到）：
# RUNTIME_IMAGE=docker.1ms.run/library/node:22-slim
#    切 slim 后 Dockerfile.app 的 HEALTHCHECK 走 /nodejs/bin/node（distroless 专用路径）
#    需要把它改成 /usr/local/bin/node 或直接 node，否则 app 会一直 unhealthy。
BUILDER_IMAGE=
RUNTIME_IMAGE=
# MariaDB 镜像仅在 DB_TYPE=mariadb 时用到。国内部署推荐镜像加速：
MARIADB_IMAGE=docker.1ms.run/library/mariadb:11.4

# ====================================
# SMTP 邮件（仅 PASSWORD_RESET_ENABLED=true 生效）
# 参考：
#   QQ 邮箱   smtp.qq.com:465    SMTP_SECURE=true
#   163 邮箱  smtp.163.com:465   SMTP_SECURE=true
#   Gmail     smtp.gmail.com:465 SMTP_SECURE=true（需应用专用密码）
#   Outlook   smtp.office365.com:587 SMTP_SECURE=false
# ====================================
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@your-domain.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM="Homepage <noreply@your-domain.com>"
# SMTP_REJECT_UNAUTHORIZED=true
# PUBLIC_ADMIN_URL=https://your-domain.com

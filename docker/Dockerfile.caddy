# homepage — Caddy reverse proxy + static file server
#
# 关键：**不再自己装依赖 / 自己 build**。frontend + admin 已经在 homepage-app
# 的 builder 层里构建过一次，这里直接 `--from=homepage-app:latest` 拿产物。
# 2C2G 主机上这样做能把每次 `docker compose build` 的 CPU/内存峰值几乎减半 —
# 之前会走两遍 `pnpm install` + 两遍 `vue-tsc + vite build`，SSH 会被卡死。
#
# 依赖：homepage-app 镜像必须先构建（compose 里 caddy 已经 `depends_on: app`，
# 但 build 顺序是 depends_on 不影响的，因此 scripts/update.sh / redeploy.sh
# 里显式 `build app` 后再 `build caddy`）。

FROM homepage-app:latest AS app-artifacts

FROM caddy:2-alpine

# /static/frontend + /static/admin 是 Dockerfile.app 最后一层已经拷好的。
# 直接搬到 Caddy 期望的 /var/www 下即可，零构建。
COPY --from=app-artifacts /static/frontend /var/www/frontend
COPY --from=app-artifacts /static/admin /var/www/admin

COPY caddy/Caddyfile /etc/caddy/Caddyfile
COPY caddy/entrypoint.sh /usr/local/bin/caddy-entrypoint.sh
RUN chmod +x /usr/local/bin/caddy-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/caddy-entrypoint.sh"]
